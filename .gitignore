/target
**/target
Cargo.lock.bak
*.aether.bak
.DS_Store
/out
# Sample downloads for the editor's sample library (File ▸ Sample library…):
# third-party characters with their own licences, kept out of the repository.
/assets_sample/
# Web player build outputs (runtime/web/build.sh)
/runtime/web/aether_player.wasm
/runtime/web/model/
/runtime/web/test/reference/
/runtime/web/test/tracking-assets/
# Godot extension build outputs (runtime/godot/build.sh) and Godot's cache
/runtime/godot/addons/aether/bin/
/runtime/godot/model/
/runtime/godot/test/reference/
/runtime/godot/test/fixture/
/runtime/godot/.godot/
# Unity package build outputs (runtime/unity/build.sh) and .NET test builds
/runtime/unity/com.aethercanvas.player/Runtime/Plugins/
/runtime/unity/com.aethercanvas.player/Runtime/Plugins.meta
/runtime/unity/com.aethercanvas.player/Tests~/*/bin/
/runtime/unity/com.aethercanvas.player/Tests~/*/obj/
