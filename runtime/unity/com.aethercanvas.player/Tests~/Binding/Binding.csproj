<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the package's C# binding (Runtime/Player.cs, Runtime/LipSync.cs)
       against the native library with plain .NET: runtime/unity/test.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Runtime/Player.cs" Link="Player.cs" />
    <Compile Include="../../Runtime/LipSync.cs" Link="LipSync.cs" />
  </ItemGroup>
</Project>
