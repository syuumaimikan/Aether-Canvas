[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2
reloadable = true

[libraries]
linux.debug.x86_64 = "res://addons/aether/bin/libaether_godot.so"
linux.release.x86_64 = "res://addons/aether/bin/libaether_godot.so"
windows.debug.x86_64 = "res://addons/aether/bin/aether_godot.dll"
windows.release.x86_64 = "res://addons/aether/bin/aether_godot.dll"
macos.debug = "res://addons/aether/bin/libaether_godot.dylib"
macos.release = "res://addons/aether/bin/libaether_godot.dylib"
